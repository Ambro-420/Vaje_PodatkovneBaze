--2) naloga
a)
SELECT ime, priimek SUM(ure) AS "skupno število ur" FROM osebe JOIN skupine on osebe.id = skupine.učitelj
GROUP BY osebe.id, ime, priimek #grupiranje po id-ju, da se osebe z istimi imeni ne pomešajo

b)
SELECT ime, priimek 
FROM osebe
JOIN skupine on osebe.id = skupine.učitelj
GROUP BY osebe.id, ime, priimek 
HAVING SUM(CASE WHEN tip = 'P' THEN 1 ELSE 0 END) > 0 
   AND SUM(CASE WHEN tip IN ('V', 'L') THEN 1 ELSE 0 END) > 0;

c)
SELECT COUNT(DISTINCT osebe.id), smer FROM osebe 
JOIN skupine ON osebe.id = skupine.učitelj 
JOIN dodelitve ON skupine.id = dodelitve.skupina
JOIN predmeti ON dodelitve.predmet = predmeti.id
GROUP BY predmeti.smer

