a)
UPDATE predmeti
SET smer = "PeMa"
WHERE smer = "2PeMa"

posebno) želim imena predmetov, ki se pojavijo na prvi in drugi stopnji
SELECT p1.ime
FROM predmeti p1 --zapisi 1. stopnje
JOIN predmeti p2 --zapisi 2. stopnje
  ON p1.ime = p2.ime --povežemo vrstice, ki imajo isto ime predmeta
  --SUBSTR(stolpec/niz, zacetek, dolzina) iz besedila izreže del niza znakov
WHERE SUBSTR(p1.smer, 1, 1) = '1'
  AND SUBSTR(p2.smer, 1,1) = '2'
  
ALI

SELECT p1.ime, p1.smer, p2.smer
FROM predmeti p1 --zapisi 1. stopnje
JOIN predmeti p2 --zapisi 2. stopnje
  ON p1.ime = p2.ime --povežemo vrstice, ki imajo isto ime predmeta
WHERE p1.smer LIKE '1%'
  AND p2.smer LIKE '2%'

b)
INSERT INTO predmeti(ime, smer)
SELECT DISTINCT p1.ime, '0Mate'
FROM predmeti p1
JOIN predmeti p2
ON p1.ime = p2.ime
WHERE p1.smer LIKE '1%'

--4) naloga
--a)
SELECT 
    osebe.id, 
    osebe.ime, 
    osebe.priimek, 
    COALESCE(SUM(skupine.ure), 0) AS "skupno število ur vaj"
FROM osebe 
LEFT JOIN skupine 
    ON osebe.id = skupine.učitelj 
    AND (skupine.tip = 'V' OR skupine.tip = 'L')
GROUP BY osebe.id, osebe.ime, osebe.priimek;

--b)
SELECT  predmeti.id, predmeti.ime, predmeti.smer   
    FROM skupine 
    JOIN dodelitve ON skupine.id = dodelitve.skupina
    JOIN predmeti  ON dodelitve.predmet = predmeti.id  
GROUP BY predmeti.id, predmeti.ime, predmeti.smer   
HAVING SUM(CASE WHEN skupine.tip = 'S' THEN 1 ELSE 0 END) > 1 
    AND SUM(CASE WHEN skupine.tip NOT LIKE 'S' THEN 1 ELSE 0 END) = 0
